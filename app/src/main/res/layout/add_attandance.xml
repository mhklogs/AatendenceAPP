<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/clg"
    android:fillViewport="true"
    tools:context=".AddAttandanceSessionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="28dp">

        <TextView
            style="@style/AttendioHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_title" />

        <TextView
            style="@style/AttendioHeaderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/session_subtitle" />

        <LinearLayout
            style="@style/AttendioPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_branch" />

            <Spinner
                android:id="@+id/spinner1"
                style="@style/AttendioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_year" />

            <Spinner
                android:id="@+id/spinneryear"
                style="@style/AttendioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_subject" />

            <Spinner
                android:id="@+id/spinnerSE"
                style="@style/AttendioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_date" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/DateEditText"
                    style="@style/AttendioEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:ems="10"
                    android:hint="@string/field_date" />

                <ImageButton
                    android:id="@+id/DateImageButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_row_icon"
                    android:contentDescription="@string/field_date"
                    android:padding="14dp"
                    android:cropToPadding="true"
                    android:src="@drawable/calendar_icon" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonsubmit"
            style="@style/AttendioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/session_action" />

        <Button
            android:id="@+id/viewAttendancebutton"
            style="@style/AttendioButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/session_view" />

        <Button
            android:id="@+id/viewTotalAttendanceButton"
            style="@style/AttendioButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/session_view_total" />
    </LinearLayout>
</ScrollView>
