<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/clg"
    android:fillViewport="true"
    tools:context=".AddStudentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/textViewFormName"
            style="@style/AttendioHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_student_title" />

        <TextView
            style="@style/AttendioHeaderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/add_student_subtitle" />

        <LinearLayout
            style="@style/AttendioPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_first_name" />

            <EditText
                android:id="@+id/editTextFirstName"
                style="@style/AttendioEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ems="10"
                android:hint="@string/field_first_name"
                android:inputType="textPersonName">

                <requestFocus />
            </EditText>

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_last_name" />

            <EditText
                android:id="@+id/editTextLastName"
                style="@style/AttendioEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ems="10"
                android:hint="@string/field_last_name"
                android:inputType="textPersonName" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_contact" />

            <EditText
                android:id="@+id/editTextPhone"
                style="@style/AttendioEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ems="10"
                android:hint="@string/field_contact"
                android:inputType="phone" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_address" />

            <EditText
                android:id="@+id/editTextaddr"
                style="@style/AttendioEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ems="10"
                android:hint="@string/field_address"
                android:inputType="textPostalAddress" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_branch" />

            <Spinner
                android:id="@+id/spinnerdept"
                style="@style/AttendioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AttendioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/field_year" />

            <Spinner
                android:id="@+id/spinneryear"
                style="@style/AttendioSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/MessageforRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/empty"
            android:textColor="@color/warning" />

        <Button
            android:id="@+id/RegisterButton"
            style="@style/AttendioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/add_student_action" />

        <Button
            android:id="@+id/Cancel_Button"
            style="@style/AttendioButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
