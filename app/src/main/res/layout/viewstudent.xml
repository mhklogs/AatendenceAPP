<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/clg"
    android:fillViewport="true"
    tools:context=".ViewStudentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/textView1"
            style="@style/AttendioHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_students_title" />

        <TextView
            android:id="@+id/textView2"
            style="@style/AttendioHeaderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/view_students_subtitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Attendio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/AttendioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/field_branch" />

                <Spinner
                    android:id="@+id/spinnerbranchView"
                    style="@style/AttendioSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/AttendioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/field_year" />

                <Spinner
                    android:id="@+id/spinneryearView"
                    style="@style/AttendioSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            style="@style/Widget.Attendio.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/show_students" />
    </LinearLayout>
</ScrollView>
