<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Attendio themes.
        Base application theme, dependent on API level.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Material.Light" />

    <!-- Application theme. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primaryDark</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:statusBarColor">@color/primaryDark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Buttons and inputs -->
        <item name="android:buttonStyle">@style/AttendioButton</item>
        <item name="android:editTextStyle">@style/AttendioEditText</item>
    </style>

    <!-- Modern filled brand button -->
    <style name="AttendioButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Outlined / secondary button -->
    <style name="AttendioButton.Outlined">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Menu navigation row -->
    <style name="AttendioMenuButton">
        <item name="android:background">@drawable/bg_list_row</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Menu logout row -->
    <style name="AttendioMenuButton.Outlined">
        <item name="android:background">@drawable/bg_list_row</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:drawableTint">@color/danger</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Rounded filled input field (light surfaces) -->
    <style name="AttendioEditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Rounded translucent input field (gradient / dark screens) -->
    <style name="AttendioEditTextOnDark">
        <item name="android:background">@drawable/bg_input_on_dark</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#B9C4F5</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textCursorDrawable">@drawable/bg_cursor</item>
    </style>

    <!-- Screen section title -->
    <style name="AttendioTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Screen title shown on gradient headers -->
    <style name="AttendioHeader">
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Supporting text under a gradient header title -->
    <style name="AttendioHeaderSub">
        <item name="android:textColor">#C7D2FE</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Floating white card panel for forms -->
    <style name="AttendioPanel">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">3dp</item>
        <item name="android:padding">20dp</item>
    </style>

    <!-- Field label inside a form panel -->
    <style name="AttendioLabel">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Small section header inside a panel -->
    <style name="AttendioPanelTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rounded spinner matching the input fields -->
    <style name="AttendioSpinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <!-- List row: white card with leading icon -->
    <style name="AttendioListRow">
        <item name="android:background">@drawable/bg_list_row</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:elevation">1dp</item>
    </style>
</resources>