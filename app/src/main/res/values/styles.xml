<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Attendio themes.
        Base application theme, dependent on API level.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Material.Light" />

    <!-- Application theme. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primaryDark</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:statusBarColor">@color/primaryDark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Buttons and inputs -->
        <item name="android:buttonStyle">@style/AttendioButton</item>
        <item name="android:editTextStyle">@style/AttendioEditText</item>
    </style>

    <!-- Modern filled brand button -->
    <style name="AttendioButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Outlined / secondary button -->
    <style name="AttendioButton.Outlined">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Menu navigation row -->
    <style name="AttendioMenuButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- Menu logout row -->
    <style name="AttendioMenuButton.Outlined">
        <item name="android:background">@drawable/bg_button_light</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- Rounded filled input field (light surfaces) -->
    <style name="AttendioEditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Rounded translucent input field (gradient / dark screens) -->
    <style name="AttendioEditTextOnDark">
        <item name="android:background">@drawable/bg_input_on_dark</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#B9C4F5</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textCursorDrawable">@drawable/bg_cursor</item>
    </style>

    <!-- Screen section title -->
    <style name="AttendioTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>