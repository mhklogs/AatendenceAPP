<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Attendio design system — Material 3.
        A single light theme tuned to the indigo/cyan brand palette.
    -->
    <style name="AppBaseTheme" parent="Theme.Material3.Light" />

    <style name="AppTheme" parent="AppBaseTheme">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>
        <item name="colorError">@color/danger</item>
        <item name="colorErrorContainer">@color/dangerContainer</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/onSurface</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Component defaults -->
        <item name="materialButtonStyle">@style/Widget.Attendio.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Attendio.Card</item>
        <item name="textInputStyle">@style/Widget.Attendio.TextInput</item>
        <item name="chipStyle">@style/Widget.Attendio.Chip</item>
        <item name="toolbarStyle">@style/Widget.Attendio.Toolbar</item>
    </style>

    <!-- ============================ Buttons ============================ -->

    <style name="Widget.Attendio.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">12dp</item>
    </style>

    <style name="Widget.Attendio.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="iconPadding">12dp</item>
    </style>

    <style name="Widget.Attendio.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Legacy aliases kept so any remaining layout honours the new look -->
    <style name="AttendioButton" parent="Widget.Attendio.Button" />
    <style name="AttendioButton.Outlined" parent="Widget.Attendio.Button.Outlined" />
    <style name="AttendioMenuButton" parent="Widget.Attendio.Button.Tonal" />
    <style name="AttendioMenuButton.Outlined" parent="Widget.Attendio.Button.Outlined" />

    <!-- ============================ Cards ============================ -->

    <style name="Widget.Attendio.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outlineVariant</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Widget.Attendio.Card.Row" parent="Widget.Attendio.Card">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- ============================ Inputs ============================ -->

    <style name="Widget.Attendio.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>

    <!-- Outlined input placed on the dark gradient hero (login) -->
    <style name="Widget.Attendio.TextInput.OnDark" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#1FFFFFFF</item>
        <item name="boxStrokeColor">#66FFFFFF</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">#C7D2FE</item>
        <item name="android:textColorHint">#C7D2FE</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Legacy input styles -->
    <style name="AttendioEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AttendioEditTextOnDark" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_on_dark</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#B9C4F5</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textCursorDrawable">@drawable/bg_cursor</item>
    </style>

    <style name="AttendioSpinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <!-- ============================ Chips ============================ -->

    <style name="Widget.Attendio.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surfaceVariant</item>
        <item name="chipStrokeColor">@color/outlineVariant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- ============================ Toolbar ============================ -->

    <style name="Widget.Attendio.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/onPrimary</item>
        <item name="subtitleTextColor">#C7D2FE</item>
        <item name="navigationIconTint">@color/onPrimary</item>
    </style>

    <!-- ============================ Text ============================ -->

    <style name="AttendioTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AttendioHeader">
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AttendioHeaderSub">
        <item name="android:textColor">#C7D2FE</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AttendioLabel">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="AttendioPanelTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============================ Layout helpers ============================ -->

    <style name="AttendioPanel">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">1dp</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="AttendioListRow">
        <item name="android:background">@drawable/bg_list_row</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="TextAppearance.Attendio.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.Attendio.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textSecondary</item>
    </style>
</resources>
